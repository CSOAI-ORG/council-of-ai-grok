{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'D=\"${CLAUDE_PLUGIN_ROOT:-${GROK_PLUGIN_ROOT:-$HOME/.claude/plugins/marketplaces/council-of-ai}}\"; [ -f \"$D/scripts/session-start.mjs\" ] && node \"$D/scripts/session-start.mjs\" || exit 0'",
            "timeout": 8
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'D=\"${CLAUDE_PLUGIN_ROOT:-${GROK_PLUGIN_ROOT:-$HOME/.claude/plugins/marketplaces/council-of-ai}}\"; [ -f \"$D/scripts/session-stop-hint.mjs\" ] && node \"$D/scripts/session-stop-hint.mjs\" || exit 0'",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
